# Copy to .env and fill in real values. Never commit .env.
APP_ENV=development
APP_DEBUG=true

DB_HOST=127.0.0.1
DB_PORT=3306
DB_NAME=meditrack
DB_USER=meditrack_app
DB_PASS=changeme

SESSION_LIFETIME_SECONDS=3600
SESSION_COOKIE_SECURE=true

# Origin allowed to call the API with credentials (frontend host), no trailing slash.
FRONTEND_ORIGIN=http://localhost:5173

# Semaphore SMS gateway (https://semaphore.co) — required for FR-6 automated SMS.
SEMAPHORE_API_KEY=
SEMAPHORE_SENDER_NAME=MediTrack

# Set to true in local/dev without a Semaphore account: notifications are
# logged instead of sent, so stock-update flows can be tested end-to-end.
SMS_DRY_RUN=true
